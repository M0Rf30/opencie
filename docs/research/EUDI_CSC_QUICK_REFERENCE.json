{
  "metadata": {
    "title": "EUDI Wallet & CSC API v2 - Quick Reference",
    "version": "1.0",
    "date": "May 2026",
    "status": "Production-Ready"
  },
  "eudi_wallet": {
    "arf_version": "1.6",
    "arf_release_date": "2026-03-07",
    "legal_basis": "eIDAS Regulation 2024/1183",
    "key_components": {
      "PID": {
        "name": "Person Identification Data",
        "formats": ["SD-JWT VC (dc+sd-jwt)", "mso_mdoc"],
        "mandatory": true,
        "loa": "High"
      },
      "mDL": {
        "name": "Mobile Driving Licence",
        "standard": "ISO/IEC 18013-5:2021",
        "format": "mso_mdoc",
        "mandatory": true
      },
      "EAA": {
        "name": "Electronic Attestation of Attributes",
        "types": ["QEAA", "PuB-EAA", "EAA"],
        "formats": ["SD-JWT VC", "mso_mdoc"],
        "mandatory": true
      },
      "QES": {
        "name": "Qualified Electronic Signature",
        "protocol": "CSC API v2.x",
        "mandatory": true
      }
    },
    "protocols": {
      "openid4vci": {
        "name": "OpenID for Verifiable Credential Issuance",
        "version": "1.0",
        "status": "Final (RFC-track)",
        "published": "2025-09-16",
        "url": "https://openid.net/specs/openid-4-verifiable-credential-issuance-1_0.html",
        "endpoints": {
          "metadata": "/.well-known/openid-credential-issuer",
          "authorization": "/authorization",
          "token": "/token",
          "credential": "/credential",
          "batch_credential": "/batch_credential",
          "deferred_credential": "/deferred_credential",
          "notification": "/notification"
        },
        "credential_formats": ["mso_mdoc", "dc+sd-jwt", "jwt_vc_json"],
        "proof_types": ["jwt", "cwt"]
      },
      "openid4vp": {
        "name": "OpenID for Verifiable Presentations",
        "version": "1.0",
        "status": "Final (RFC-track)",
        "published": "2025-07-09",
        "url": "https://openid.net/specs/openid-4-verifiable-presentations-1_0.html",
        "response_types": ["vp_token", "vp_token id_token"],
        "response_modes": ["fragment", "query", "form_post", "direct_post", "direct_post.jwt"],
        "query_language": "DCQL (Digital Credentials Query Language)",
        "credential_formats": ["mso_mdoc", "dc+sd-jwt", "jwt_vc_json"]
      }
    },
    "credential_formats": {
      "sd_jwt_vc": {
        "name": "SD-JWT VC (Selective Disclosure JWT Verifiable Credential)",
        "format_id": "dc+sd-jwt",
        "base_spec": "RFC 9901 (Selective Disclosure for JWTs)",
        "draft_spec": "draft-ietf-oauth-sd-jwt-vc-15",
        "status": "IETF Standards Track (near-final)",
        "published": "2026-02-26",
        "structure": "JWT ~ Disclosure1 ~ Disclosure2 ~ ... ~ DisclosureN",
        "key_binding": "Optional (KB-JWT)",
        "selective_disclosure": true,
        "use_cases": ["PID", "EAA", "Educational credentials", "Professional qualifications"]
      },
      "mso_mdoc": {
        "name": "Mobile Security Object (mDL/mdoc)",
        "standard": "ISO/IEC 18013-5:2021",
        "extended_by": "ISO/IEC TS 18013-7:2025",
        "format": "CBOR (Concise Binary Object Representation)",
        "cryptography": "COSE (CBOR Object Signing and Encryption)",
        "key_binding": "Device key (P-256 ECDSA)",
        "selective_disclosure": true,
        "device_engagement": ["NFC", "BLE", "QR Code", "OIDC", "WebAPI"],
        "use_cases": ["mDL", "PID", "Travel credentials"]
      }
    },
    "italian_pid": {
      "repository": "https://github.com/italia/eid-wallet-it-docs",
      "version": "1.4.0",
      "legal_basis": "Decreto-Legge n. 19 (2024), Legge n. 56 (2024)",
      "authorities": ["Department for Digital Transformation", "IPZS", "PagoPA", "AGID"],
      "data_model": {
        "sd_jwt_vc": {
          "vct": "https://example.com/credentials/identity",
          "claims": ["given_name", "family_name", "birth_date", "unique_id", "issuance_date", "expiry_date"]
        },
        "mso_mdoc": {
          "doctype": "eu.europa.ec.eudi.pid.1",
          "namespace": "eu.europa.ec.eudi.pid.1",
          "claims": ["given_name", "family_name", "birth_date", "unique_id", "issuance_date", "expiry_date"]
        }
      },
      "issuance_flow": ["User Identification (eID Substantial Auth)", "Credential Request (OpenID4VCI)", "Proof of Possession (JWT)", "Credential Response (SD-JWT VC or mso_mdoc)"]
    },
    "dart_flutter": {
      "official_libraries": {
        "android": "eudi-lib-android-wallet-core (Kotlin)",
        "ios": "eudi-lib-ios-wallet-core (Swift)",
        "sdjwt": "eudi-lib-jvm-sdjwt (Kotlin), eudi-lib-sdjwt-swift (Swift)"
      },
      "dart_options": [
        "Wrap Kotlin/Swift libraries via platform channels",
        "Port from TypeScript (sd-jwt-js) or Rust (openid4vc)",
        "Use existing Dart packages (pointycastle, cbor, jose, http)"
      ],
      "recommended_packages": {
        "cryptography": "pointycastle, cryptography",
        "cbor": "cbor (for mDL)",
        "jwt": "jose (JWT/JWE)",
        "http": "http (HTTP client)",
        "storage": "flutter_secure_storage (key storage)"
      }
    }
  },
  "csc_api": {
    "version": "2.2",
    "released": "2025-11-06",
    "previous_versions": ["2.1.0.1 (2025-01-22)", "2.0.0.2 (2023-04-20)"],
    "base_uri": "https://service.domain.org/xxx/csc/v2/",
    "endpoints": {
      "info": {
        "method": "GET/POST",
        "auth": "None",
        "purpose": "Service metadata discovery"
      },
      "oauth2_authorize": {
        "method": "GET",
        "auth": "None",
        "purpose": "OAuth 2.0 authorization endpoint"
      },
      "oauth2_token": {
        "method": "POST",
        "auth": "Client credentials",
        "purpose": "Access token issuance"
      },
      "oauth2_revoke": {
        "method": "POST",
        "auth": "Client credentials",
        "purpose": "Token revocation"
      },
      "credentials_list": {
        "method": "POST",
        "auth": "Bearer (service scope)",
        "purpose": "List user credentials"
      },
      "credentials_info": {
        "method": "POST",
        "auth": "Bearer (service scope)",
        "purpose": "Get credential details"
      },
      "credentials_authorize": {
        "method": "POST",
        "auth": "Bearer (service scope)",
        "purpose": "Authorize credential use (get SAD)"
      },
      "signatures_signHash": {
        "method": "POST",
        "auth": "Bearer (credential scope)",
        "purpose": "Sign hash(es)"
      },
      "signatures_signDoc": {
        "method": "POST",
        "auth": "Bearer (credential scope)",
        "purpose": "Sign document(s)"
      },
      "signatures_timestamp": {
        "method": "POST",
        "auth": "Bearer (credential scope)",
        "purpose": "Get timestamp"
      }
    },
    "oauth2": {
      "flow": "Authorization Code with PKCE",
      "scopes": {
        "service": "Access to /credentials/list, /credentials/info, /credentials/authorize",
        "credential": "Access to /signatures/signHash, /signatures/signDoc",
        "credential.read": "Read-only credential access"
      },
      "pkce": "Required (code_challenge, code_verifier)",
      "token_lifetime": "3600 seconds (1 hour)"
    },
    "sad": {
      "name": "Signature Activation Data",
      "purpose": "Authorize signature creation on HSM",
      "lifetime": "300-900 seconds (5-15 minutes)",
      "scope": "Single or multiple signatures",
      "format": "JWT",
      "claims": ["iss", "sub", "aud", "iat", "exp", "nonce", "numSignatures"]
    },
    "hash_algorithms": {
      "SHA-256": {
        "oid": "2.16.840.1.101.3.4.2.1",
        "size": 32,
        "recommended": true
      },
      "SHA-384": {
        "oid": "2.16.840.1.101.3.4.2.2",
        "size": 48,
        "recommended": true
      },
      "SHA-512": {
        "oid": "2.16.840.1.101.3.4.2.3",
        "size": 64,
        "recommended": true
      },
      "SHA-1": {
        "oid": "1.3.14.3.2.26",
        "size": 20,
        "deprecated": true
      }
    },
    "signature_algorithms": {
      "ECDSA_SHA256": {
        "oid": "1.2.840.10045.4.3.2",
        "key_type": "EC P-256",
        "hash": "SHA-256",
        "recommended": true
      },
      "ECDSA_SHA384": {
        "oid": "1.2.840.10045.4.3.3",
        "key_type": "EC P-384",
        "hash": "SHA-384",
        "recommended": true
      },
      "ECDSA_SHA512": {
        "oid": "1.2.840.10045.4.3.4",
        "key_type": "EC P-521",
        "hash": "SHA-512",
        "recommended": true
      },
      "RSA_SHA256": {
        "oid": "1.2.840.113549.1.1.11",
        "key_type": "RSA 2048+",
        "hash": "SHA-256",
        "recommended": true
      },
      "RSA_SHA384": {
        "oid": "1.2.840.113549.1.1.12",
        "key_type": "RSA 2048+",
        "hash": "SHA-384",
        "recommended": true
      },
      "RSA_SHA512": {
        "oid": "1.2.840.113549.1.1.13",
        "key_type": "RSA 2048+",
        "hash": "SHA-512",
        "recommended": true
      },
      "EdDSA": {
        "oid": "1.3.101.112",
        "key_type": "Ed25519",
        "hash": "SHA-512",
        "recommended": true
      }
    },
    "providers": {
      "infocert": {
        "country": "IT",
        "sandbox": "https://cscsandbox.infocert.it/csc/v2",
        "production": "https://csc.infocert.it/csc/v2"
      },
      "aruba": {
        "country": "IT",
        "sandbox": "https://cscsandbox.arubapec.it/csc/v2",
        "production": "https://csc.arubapec.it/csc/v2"
      },
      "namirial": {
        "country": "IT/EU",
        "sandbox": "https://sandbox.namirial.com/csc/v2",
        "production": "https://csc.namirial.com/csc/v2"
      },
      "intesi_group": {
        "country": "IT",
        "sandbox": "https://sandbox.intesigroup.com/csc/v2",
        "production": "https://csc.intesigroup.com/csc/v2"
      },
      "bankid": {
        "country": "NO",
        "sandbox": "https://trust-driver-stub-lsp.test.cleverbase.com/csc/v2"
      },
      "buypass": {
        "country": "NO",
        "sandbox": "https://api.esign.qa-04.buypass.no/csc/v2",
        "production": "https://api.esign.buypass.no/csc/v2"
      }
    }
  },
  "integration_phases": {
    "phase_6": {
      "name": "CSC Remote Signing",
      "tasks": [
        "CSC API v2.2 client implementation",
        "OAuth 2.0 PKCE flow",
        "SAD (Signature Activation Data) handling",
        "Hash algorithm support (SHA-256/384/512)",
        "Signature algorithm support (ECDSA, RSA, EdDSA)",
        "PAdES/CAdES signature wrapping",
        "Certificate chain validation",
        "Timestamp integration",
        "Error handling & retry logic",
        "Sandbox testing (InfoCert, Aruba, Namirial)"
      ]
    },
    "phase_7": {
      "name": "EUDI Wallet Integration",
      "tasks": [
        "OpenID4VCI credential issuance",
        "OpenID4VP credential presentation",
        "SD-JWT VC support",
        "mso_mdoc (CBOR) support",
        "Device key binding (ECDSA P-256)",
        "Selective disclosure",
        "Wallet metadata discovery",
        "Trust anchor validation",
        "Status list revocation check",
        "Italian PID profile compliance",
        "Cross-device QR code flow",
        "Same-device redirect flow"
      ]
    }
  },
  "references": {
    "official_specs": {
      "arf": "https://eudi.dev/2.7.0/architecture-and-reference-framework-main/",
      "openid4vci": "https://openid.net/specs/openid-4-verifiable-credential-issuance-1_0.html",
      "openid4vp": "https://openid.net/specs/openid-4-verifiable-presentations-1_0.html",
      "sd_jwt_vc": "https://datatracker.ietf.org/doc/html/draft-ietf-oauth-sd-jwt-vc-15",
      "iso_18013_5": "https://www.iso.org/standard/69084.html",
      "iso_18013_7": "https://www.iso.org/standard/91154.html",
      "csc_api": "https://cloudsignatureconsortium.org/resources/csc-api-v2-2/"
    },
    "italian_implementation": {
      "it_wallet_specs": "https://italia.github.io/eid-wallet-it-docs/versione-corrente/en/",
      "it_wallet_python": "https://github.com/italia/eudi-wallet-it-python"
    },
    "reference_implementations": {
      "eu_wallet": "https://github.com/eu-digital-identity-wallet",
      "openid4vc_rust": "https://github.com/impierce/openid4vc",
      "sd_jwt_python": "https://github.com/openwallet-foundation-labs/sd-jwt-python"
    }
  }
}
