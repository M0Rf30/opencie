<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.m0rf30.opencie</id>

  <name>OpenCIE</name>
  <summary>Sign documents with the Italian CIE</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <developer id="io.github.m0rf30">
    <name>Gianluca Boiano</name>
  </developer>

  <description>
    <p>
      Sign and verify documents with the Italian Electronic Identity Card
      (CIE — Carta d'Identità Elettronica), and manage the card itself.
    </p>
    <ul>
      <li>Sign with CAdES (.p7m), PAdES (PDF) and XAdES (.xml) using the CIE chip</li>
      <li>Verify signatures with OCSP/CRL revocation checking</li>
      <li>Manage cards: enrollment, PIN change and unblock</li>
    </ul>
    <p>
      A PC/SC-compatible smart card or contactless reader is required.
    </p>
  </description>

  <launchable type="desktop-id">io.github.m0rf30.opencie.desktop</launchable>

  <url type="homepage">https://github.com/M0Rf30/opencie</url>
  <url type="bugtracker">https://github.com/M0Rf30/opencie/issues</url>
  <url type="vcs-browser">https://github.com/M0Rf30/opencie</url>

  <content_rating type="oars-1.1"/>

  <branding>
    <color type="primary" scheme_preference="light">#dbe9ff</color>
    <color type="primary" scheme_preference="dark">#1a3a6b</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/M0Rf30/opencie/main/docs/screenshots/sign.png</image>
      <caption>Sign documents with the CIE chip</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/M0Rf30/opencie/main/docs/screenshots/verify.png</image>
      <caption>Verify digital signatures</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/M0Rf30/opencie/main/docs/screenshots/cie.png</image>
      <caption>Manage enrolled CIE cards</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/M0Rf30/opencie/main/docs/screenshots/settings.png</image>
      <caption>Application settings</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="0.1.0" date="2026-06-12">
      <description>
        <p>Initial release: CAdES/PAdES/XAdES signing, signature verification with OCSP/CRL, CIE card management.</p>
      </description>
    </release>
  </releases>

  <recommends>
    <control>pointing</control>
    <control>keyboard</control>
  </recommends>
</component>
